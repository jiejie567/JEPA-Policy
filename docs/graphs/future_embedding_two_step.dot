digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#5B6B7D", fontname="Noto Sans CJK SC, Microsoft YaHei, Arial", fontsize=12, margin="0.12,0.08"];
  edge [color="#5B6B7D", arrowsize=0.8, fontname="Noto Sans CJK SC, Microsoft YaHei, Arial", fontsize=11];

  obs [label="obs"];
  obs_emb [label="encoder(obs)\nobs_emb"];
  future_obs [label="future_obs"];
  target [label="encoder(future_obs)\nfuture_embed_target"];
  future0 [label="future_embed_0 = 0"];
  futuret [label="future_embed_t = target\n+ (1 - t_two_step) * future_noise"];
  act [label="act"];
  act0 [label="act_0 = 0"];
  actt [label="act_t = act\n+ (1 - t_two_step) * act_noise"];

  step0 [label="Future Step 1\nflow_map.net(act_0, 0, t_two_step,\nobs_emb, future_input=future_embed_0)"];
  pred0 [label="future_embed_pred_0"];
  loss0 [label="future_loss_0\n= mean(((pred_0 - target) / t_two_step)^2)"];

  step1 [label="Future Step 2\nflow_map.net(act_t, t_two_step, 1,\nobs_emb, future_input=future_embed_t)"];
  pred1 [label="future_embed_pred_1"];
  loss1 [label="future_loss_1\n= mean(((pred_1 - target) / (1 - t_two_step))^2)"];

  future_loss [label="future_loss\n= future_loss_0 + future_loss_1"];

  obs -> obs_emb;
  future_obs -> target;
  target -> future0;
  target -> futuret;
  act -> act0;
  act -> actt;

  obs_emb -> step0;
  future0 -> step0;
  act0 -> step0;
  step0 -> pred0 -> loss0 -> future_loss;

  obs_emb -> step1;
  futuret -> step1;
  actt -> step1;
  step1 -> pred1 -> loss1 -> future_loss;
}
