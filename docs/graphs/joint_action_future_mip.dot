digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#5B6B7D", fontname="Noto Sans CJK SC, Microsoft YaHei, Arial", fontsize=12, margin="0.14,0.08"];
  edge [color="#5B6B7D", arrowsize=0.8, fontname="Noto Sans CJK SC, Microsoft YaHei, Arial", fontsize=11];

  obs [label="obs"];
  obs_emb [label="encoder(obs)\nobs_emb"];
  future_obs [label="future_obs"];
  target [label="encoder(future_obs)\nfuture_embed_target"];

  act [label="真实 action: act"];
  act0 [label="act_0 = 0"];
  future0 [label="future_embed_0 = 0"];
  step0 [label="Joint Step 1\nnet(act_0, s=0, t=t_two_step,\nobs_emb, future_input=future_embed_0)"];
  act_pred0 [label="act_pred_0"];
  future_pred0 [label="future_embed_pred_0"];

  actt [label="act_t = act + (1 - t_two_step) * act_noise"];
  futuret [label="future_embed_t = target\n+ (1 - t_two_step) * future_noise"];
  step1 [label="Joint Step 2\nnet(act_t, s=t_two_step, t=1,\nobs_emb, future_input=future_embed_t)"];
  act_pred1 [label="act_pred_1"];
  future_pred1 [label="future_embed_pred_1"];

  action_loss [label="action_loss\n两段 action 误差"];
  future_loss [label="future_loss\n两段 future embedding 误差"];
  total [label="total_loss\n= loss_scale * action_loss\n+ future_embed_loss_weight * future_loss"];

  obs -> obs_emb;
  future_obs -> target;
  act -> act0;
  target -> future0;
  obs_emb -> step0;
  act0 -> step0;
  future0 -> step0;
  step0 -> act_pred0 -> action_loss;
  step0 -> future_pred0 -> future_loss;

  act -> actt;
  target -> futuret;
  obs_emb -> step1;
  actt -> step1;
  futuret -> step1;
  step1 -> act_pred1 -> action_loss;
  step1 -> future_pred1 -> future_loss;

  action_loss -> total;
  future_loss -> total;
}
