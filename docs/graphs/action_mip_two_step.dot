digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#5B6B7D", fontname="Noto Sans CJK SC, Microsoft YaHei, Arial", fontsize=12, margin="0.12,0.08"];
  edge [color="#5B6B7D", arrowsize=0.8, fontname="Noto Sans CJK SC, Microsoft YaHei, Arial", fontsize=11];

  act [label="真实 action: act"];
  act0 [label="act_0 = 0"];
  noise [label="采样 noise"];
  actt [label="act_t = act + (1 - t_two_step) * noise"];

  step0 [label="Step 1\nflow_map.get_velocity(s=0, x=act_0)"];
  pred0 [label="act_pred_0"];
  loss0 [label="action_loss_0\n= ||act_pred_0 - act||^2 / t_two_step^2"];

  step1 [label="Step 2\nflow_map.get_velocity(s=t_two_step, x=act_t)"];
  pred1 [label="act_pred_1"];
  loss1 [label="action_loss_1\n= ||act_pred_1 - act||^2 / (1 - t_two_step)^2"];

  action_loss [label="action_loss\n= mean(action_loss_0 + action_loss_1)"];
  scaled [label="base loss\n= loss_scale * action_loss"];

  act -> act0 -> step0 -> pred0 -> loss0 -> action_loss;
  act -> noise -> actt -> step1 -> pred1 -> loss1 -> action_loss;
  action_loss -> scaled;
}
