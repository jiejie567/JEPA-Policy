digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#5B6B7D", fontname="Noto Sans CJK SC, Microsoft YaHei, Arial", fontsize=12, margin="0.12,0.08"];
  edge [color="#5B6B7D", arrowsize=0.8, fontname="Noto Sans CJK SC, Microsoft YaHei, Arial", fontsize=11];

  future_obs [label="future_obs"];
  dino [shape=diamond, fillcolor="#FFF8E6", label="encoder 有\nencode_raw_dino?"];
  raw_dino [label="encoder.encode_raw_dino(future_obs)"];
  use_seq [shape=diamond, fillcolor="#FFF8E6", label="encoder.use_seq?"];
  add_seq [label="必要时补 sequence 维度"];
  direct [label="直接输入 encoder"];
  encode [label="encoder(future_obs)"];
  target [label="future_embed_target"];
  detach [label="detach\n只作为监督目标"];

  future_obs -> dino;
  dino -> raw_dino [label="是"];
  dino -> use_seq [label="否"];
  use_seq -> add_seq [label="是"];
  use_seq -> direct [label="否"];
  add_seq -> encode;
  direct -> encode;
  raw_dino -> target;
  encode -> target;
  target -> detach;
}
